#!/usr/bin/env bash
# relaygate は facade の CLI エントリポイントを提供する。
# 本ファイルは CLI deadline(CTP-009: 応答 10 秒以内)の制御と初期化だけを持ち、
# 層別のロジックは facade/src/*.sh(presentation / domain / gateway / usecase)に置く。
# shellcheck source-path=SCRIPTDIR
# 層別ライブラリへ渡す CLI 実行コンテキスト(グローバル)は sourced ファイル側で参照するため未使用警告は対象外
# shellcheck disable=SC2034
set -o errexit -o nounset -o pipefail
readonly CLI_DEADLINE_SECONDS=8

# monotonic_milliseconds は単一 CLI 実行の単調時刻をミリ秒で返す。
monotonic_milliseconds() {
	perl -MTime::HiRes=clock_gettime,CLOCK_MONOTONIC -e 'printf "%.0f", clock_gettime(CLOCK_MONOTONIC) * 1000'
}

# CLI の最初の実行境界で単一 deadline を確定する。
deadline_milliseconds=$(($(monotonic_milliseconds) + CLI_DEADLINE_SECONDS * 1000))

# initialization_error は初期化境界(スクリプト位置解決・ライブラリ読込)の失敗で終了する。
initialization_error() {
	printf '%s\n' 'CLI initialization failed (boundary=initialization)' >&2
	exit 1
}

# remaining_deadline_milliseconds は CLI 開始時点からの残余時間を返す。
remaining_deadline_milliseconds() {
	local now_milliseconds remaining_milliseconds
	now_milliseconds="$(monotonic_milliseconds)" || return 1
	remaining_milliseconds=$((deadline_milliseconds - now_milliseconds))
	((remaining_milliseconds > 0)) || return 1
	printf '%s' "$remaining_milliseconds"
}

# deadline_run_for は専用 session 内の I/O とその子プロセス群を期限で終了する。
deadline_run_for() {
	local timeout_duration="$1"
	shift
	# shellcheck disable=SC2016
	timeout --kill-after=1s "$timeout_duration" bash -c '
		perl -MPOSIX=setsid -e '\''setsid() or die "setsid failed: $!"; exec @ARGV or die "exec failed: $!"'\'' "$@" <&0 &
		child_pid=$!
		trap '\''kill -TERM -- "-$child_pid" 2>/dev/null || true; kill -KILL -- "-$child_pid" 2>/dev/null || true; wait "$child_pid" 2>/dev/null || true; exit 124'\'' TERM
		wait "$child_pid"
	' bash "$@"
}

# deadline_run は全ての外部 I/O を単一 CLI deadline までに打ち切る。
deadline_run() {
	local remaining_milliseconds timeout_duration
	remaining_milliseconds="$(remaining_deadline_milliseconds)" || return 124
	printf -v timeout_duration '%d.%03ds' "$((remaining_milliseconds / 1000))" "$((remaining_milliseconds % 1000))"
	deadline_run_for "$timeout_duration" "$@"
}

# SCRIPT_DIR は同じ CLI deadline の内側で解決する。
# shellcheck disable=SC2016
script_dir="$(deadline_run bash -c 'cd -- "$(dirname -- "$1")" && pwd -P' bash "${BASH_SOURCE[0]}")" || initialization_error
readonly SCRIPT_DIR="$script_dir"
# 契約生成物(テーブル名・列名の定数)。手動編集禁止・定数経由でのみ SQL を組み立てる
# shellcheck source=../../packages/contracts/relay-gate-db/schema-constants.sh
source "$SCRIPT_DIR/../../packages/contracts/relay-gate-db/schema-constants.sh" || initialization_error
# 層別ライブラリ(依存方向: presentation → usecase → domain → gateway)
for library in presentation domain id_gateway job_map_gateway rdb_gateway launch_gateway usecase; do
	# shellcheck source=/dev/null
	source "$SCRIPT_DIR/../src/$library.sh" || initialization_error
done

main() {
	[[ $# -ge 2 && "$1" == concurrent-run && "$2" == select-slot ]] || validation_error "usage: relaygate concurrent-run select-slot --job-id <JOB_ID> [-- <additional args...>]"
	shift 2
	parse_select_slot_request "$@"
	blue_mode="${BLUE_MODE:-}"
	green_mode="${GREEN_MODE:-}"
	rapid_crosscheck_mode="${RAPID_CROSSCHECK_MODE:-}"
	operator="${RELAYGATE_OPERATOR:-}"
	validate_select_slot_environment
	select_and_start_slot
}
main "$@"
